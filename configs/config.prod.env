# Политика публикации
POSTING_POLICY__DAY_START_HOUR=10
POSTING_POLICY__DAY_END_HOUR=22
POSTING_POLICY__POSTS_PER_DAY_MIN=8
POSTING_POLICY__POSTS_PER_DAY_MAX=12
POSTING_POLICY__INTERVAL_MIN_MINUTES=60
POSTING_POLICY__INTERVAL_MAX_MINUTES=120
POSTING_POLICY__MAX_DAILY_POSTS=20
POSTING_POLICY__BATCH_SIZE=20
POSTING_POLICY__AUTO_CLEANUP=true
