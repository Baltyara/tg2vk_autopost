# Конфигурация для продакшена
# Скопируйте этот файл в .env на сервере и заполните значения

# Часовой пояс
TZ=Europe/Moscow

# Telegram API
TG_API_ID=27435631
TG_API_HASH=c88866acc346c546dc2061f33414ff9c
TG_SESSION_STRING=your_session_string_here
TG_INVITE_LINK=https://t.me/joinchat/AAAAAFElevcbuyK0EeBX9Q

# VK API
VK_GROUP_TOKEN=your_vk_token_here
VK_GROUP_ID=club147630752

# GigaChat API (опционально)
GIGACHAT_CLIENT_ID=e207f4c0-3fc6-4725-8cc3-629d726dd522
GIGACHAT_CLIENT_SECRET=your_gigachat_secret_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
